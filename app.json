{
  "expo": {
    "name": "O-GO",
    "slug": "o-go",
    "version": "1.0.0",
    "scheme": "o-go",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF4500"
    },
    "ios": {
      "bundleIdentifier": "com.teamogo.ogo",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.723671040157-ufo3l8g9s5hc914em5g41m728v2590u9"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.teamogo.ogo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4500"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b40b9b73-552d-491c-98ea-ff40745bfbdf"
      }
    },
    "plugins": [
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
